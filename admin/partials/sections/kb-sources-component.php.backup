<?php
/**
 * Knowledge Base Content Sources Component - Refactored
 * Matches Chatbot Visibility UI/UX pattern
 */

// Get current KB settings - using new "include_all" pattern
$kb_include_all_pages = (bool) get_option('aethos_kb_include_all_pages', true);
$kb_included_pages = get_option('aethos_kb_included_pages', array());
if (!is_array($kb_included_pages)) {
    $kb_included_pages = array();
}
$kb_excluded_pages = get_option('aethos_kb_excluded_pages', array());
if (!is_array($kb_excluded_pages)) {
    $kb_excluded_pages = array();
}
$kb_pages_auto_sync = (bool) get_option('aethos_kb_pages_auto_sync', true);

$kb_include_all_posts = (bool) get_option('aethos_kb_include_all_posts', true);
$kb_included_posts = get_option('aethos_kb_included_posts', array());
if (!is_array($kb_included_posts)) {
    $kb_included_posts = array();
}
$kb_excluded_posts = get_option('aethos_kb_excluded_posts', array());
if (!is_array($kb_excluded_posts)) {
    $kb_excluded_posts = array();
}
$kb_posts_auto_sync = (bool) get_option('aethos_kb_posts_auto_sync', true);

// Fetch all pages
$all_pages = get_posts(array(
    'post_type' => 'page',
    'posts_per_page' => -1,
    'post_status' => 'publish',
    'orderby' => 'title',
    'order' => 'ASC'
));
if (!is_array($all_pages)) {
    $all_pages = array();
}

// Fetch all posts
$all_posts = get_posts(array(
    'post_type' => 'post',
    'posts_per_page' => -1,
    'post_status' => 'publish',
    'orderby' => 'title',
    'order' => 'ASC'
));
if (!is_array($all_posts)) {
    $all_posts = array();
}

// Get custom post types
$args = array(
    'public' => true,
    '_builtin' => false
);
$custom_post_types = get_post_types($args, 'objects');
?>

