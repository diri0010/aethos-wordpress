}

/* Modern Select Dropdown - matches Visibility */
.aethos-kb-select-wrapper {
    position: relative;
    margin-bottom: 16px;
}

.aethos-kb-select-wrapper[data-disabled="true"] {
    opacity: 0.5;
    pointer-events: none;
}

.aethos-kb-select-box {
    position: relative;
}

.aethos-kb-select-dropdown {
    width: 100%;
    padding: 12px 40px 12px 16px;
    font-size: 14px;
    color: #374151;
    background: #ffffff;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
