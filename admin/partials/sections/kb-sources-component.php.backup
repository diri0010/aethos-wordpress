}

/* Selected Items - matches Visibility */
.aethos-kb-selected-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-height: 60px;
    padding: 12px;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
