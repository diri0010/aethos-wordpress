}

.aethos-kb-tab-button {
    padding: 12px 24px;
    border: none;
    background: none;
    color: #6b7280;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    transition: all 0.2s;
}

.aethos-kb-tab-button:hover {
    color: #374151;
}

.aethos-kb-tab-button.active {
    color: #4f46e5;
    border-bottom-color: #4f46e5;
}

/* Tab Content */
.aethos-kb-tab {
    display: none !important;
}

.aethos-kb-tab.active {
    display: block !important;
}

/* Include All Option - matches Visibility */
.aethos-kb-all-option {
    display: flex;
    align-items: center;
    gap: 8px;
